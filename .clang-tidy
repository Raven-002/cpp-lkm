# Strict: enable all checks, disable only irrelevant (platform/domain-specific).
# Disabled: altera, android, darwin, fuchsia/zircon, objc, llvmlibc; readability-magic-numbers.
# Also disabled: checks that don't apply to kernel/compat/C-interop (see comments).
Checks: >
  *,
  -readability-magic-numbers,
  -altera-*,
  -android-*,
  -darwin-*,
  -fuchsia-*,
  -zircon-*,
  -objc-*,
  -google-objc-*,
  -llvmlibc-*,
  -cert-dcl58-cpp,
  -cert-dcl54-cpp,
  -cert-dcl37-c,
  -cert-dcl51-cpp,
  -llvm-header-guard,
  -portability-avoid-pragma-once,
  -readability-identifier-length,
  -misc-include-cleaner,
  -hicpp-deprecated-headers,
  -modernize-deprecated-headers,
  -performance-enum-size,
  -modernize-use-trailing-return-type,
  -cppcoreguidelines-missing-std-forward,
  -google-readability-braces-around-statements,
  -hicpp-braces-around-statements,
  -readability-braces-around-statements,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-special-member-functions,
  -hicpp-special-member-functions,
  -cppcoreguidelines-avoid-c-arrays,
  -hicpp-avoid-c-arrays,
  -modernize-avoid-c-arrays,
  -misc-use-anonymous-namespace,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -hicpp-no-array-decay,
  -cppcoreguidelines-pro-type-vararg,
  -hicpp-vararg,
  -hicpp-new-delete-operators,
  -misc-new-delete-overloads,
  -hicpp-named-parameter,
  -readability-named-parameter,
  -bugprone-reserved-identifier,
  -readability-implicit-bool-conversion,
  -misc-const-correctness,
  -bugprone-easily-swappable-parameters,
  -hicpp-use-nullptr,
  -modernize-use-nullptr,
  -cppcoreguidelines-pro-type-cstyle-cast,
  -cert-err33-c,
  -modernize-use-std-print,
  -misc-non-private-member-variables-in-classes,
  -google-explicit-constructor,
  -hicpp-explicit-conversions,
  -misc-use-internal-linkage,
  -cppcoreguidelines-avoid-magic-numbers,
  -cert-dcl03-c,
  -hicpp-static-assert,
  -misc-static-assert,
  -clang-analyzer-cplusplus.NewDeleteLeaks,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic
WarningsAsErrors: '*'
HeaderFilterRegex: '^(include|src|tests|compat|mock_kernel)/'
FormatStyle: file
