# Enable all checks; disable only rules that do not apply to this project or cannot be
# satisfied without fighting required APIs or tooling.

Checks:
  - '*' # enable all checks, then selectively disable below

  # Irrelevant platforms.
  - '-altera-*'
  - '-android-*'
  - '-darwin-*'
  - '-fuchsia-*'
  - '-zircon-*'
  - '-objc-*'
  - '-google-objc-*'
  - '-llvmlibc-*'

  # Compatibility: C varargs (cpp_printk + mocks).
  - '-cppcoreguidelines-pro-type-vararg'
  - '-hicpp-vararg'

  # Style: pragma once convention.
  - '-llvm-header-guard'
  - '-portability-avoid-pragma-once'

  # Style: intentional numeric literals.
  - '-readability-magic-numbers'
  - '-cppcoreguidelines-avoid-magic-numbers'

  # Style: leading return types are project convention.
  - '-modernize-use-trailing-return-type'

  # Tooling: include graph not complete; noisy here.
  - '-misc-include-cleaner'

  # Namespace std: libstdc++ assertion hook contract.
  - '-cert-dcl58-cpp'

  # Operator new/delete: delete-only policy in this repo.
  - '-cert-dcl54-cpp'
  - '-hicpp-new-delete-operators'
  - '-misc-new-delete-overloads'

  # Modernize: project does not use C++23 std::println.
  - '-modernize-use-std-print'

  # Ownership: expressed via std::expected + placement new.
  - '-cppcoreguidelines-owning-memory'

  # Anonymous namespace: conflicts with llvm-prefer-static-over-anonymous-namespace.
  - '-misc-use-anonymous-namespace'
WarningsAsErrors: '*'
# Match project paths from compile_commands (often absolute) and relative invocations.
HeaderFilterRegex: '(^|/)((include|src|tests|compat)/)'
FormatStyle: file
